# The DNS A/AAAA records must point to this server before Certbot starts.
DOMAIN=new.apap.kg
CERTBOT_EMAIL=contact@agupkr.kg

# Host directory for certificates and ACME files. Use an absolute path in production.
# Its contents remain on disk after `docker compose down -v` or Docker removal.
CERTBOT_DATA_DIR=/opt/agu_pkr/certbot
